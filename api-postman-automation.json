							"listen": "prerequest",
							"script": {
								"exec": [
									"// Generate random string for updated booking",
									"function generateRandomString(length) {",
									"    let result = '';",
									"    const characters = 'abcdefghijklmnopqrstuvwxyz0123456789';",
									"    for (let i = 0; i < length; i++) {",
									"        result += characters.charAt(Math.floor(Math.random() * characters.length));",
									"    }",
									"    return result;",
									"}",
									"",
									"function getFutureDate(daysFromNow) {",
									"    const date = new Date();",
									"    date.setDate(date.getDate() + daysFromNow);",
									"    return date.toISOString().split('T')[0];",
									"}",
									"",
									"const randomStr = generateRandomString(6);",
									"pm.collectionVariables.set(\"updatedFirstname\", \"UpdatedName\");",
									"pm.collectionVariables.set(\"updatedLastname\", \"Doe\" + randomStr);",
									"pm.collectionVariables.set(\"checkinDate\", getFutureDate(7));",
									"pm.collectionVariables.set(\"checkoutDate\", getFutureDate(14));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Booking was updated successfully\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.firstname).to.eql(\"UpdatedName\");",
									"    pm.expect(jsonData.totalprice).to.eql(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
