				{
					"name": "6. Create New Booking",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Generate random string for unique booking",
									"function generateRandomString(length) {",
									"    let result = '';",
									"    const characters = 'abcdefghijklmnopqrstuvwxyz0123456789';",
									"    for (let i = 0; i < length; i++) {",
									"        result += characters.charAt(Math.floor(Math.random() * characters.length));",
									"    }",
									"    return result;",
									"}",
									"",
									"// Generate future dates",
									"function getFutureDate(daysFromNow) {",
									"    const date = new Date();",
									"    date.setDate(date.getDate() + daysFromNow);",
									"    return date.toISOString().split('T')[0];",
									"}",
									"",
									"const randomStr = generateRandomString(6);",
									"pm.collectionVariables.set(\"randomFirstname\", \"John\" + randomStr);",
									"pm.collectionVariables.set(\"randomLastname\", \"Doe\" + randomStr);",
									"pm.collectionVariables.set(\"checkinDate\", getFutureDate(7));",
									"pm.collectionVariables.set(\"checkoutDate\", getFutureDate(14));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has bookingid property\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('bookingid');",
									"});",
									"",
									"pm.test(\"Response has booking property\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('booking');",
									"});",
									"",
									"pm.test(\"Booking data matches request\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.booking.firstname).to.eql(pm.collectionVariables.get(\"randomFirstname\"));",
									"    pm.expect(jsonData.booking.lastname).to.eql(pm.collectionVariables.get(\"randomLastname\"));",
									"    pm.expect(jsonData.booking.totalprice).to.eql(150);",
									"});",
									"",
									"// Save booking ID for future tests",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"bookingId\", jsonData.bookingid);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstname\": \"{{randomFirstname}}\",\n    \"lastname\": \"{{randomLastname}}\",\n    \"totalprice\": 150,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"{{checkinDate}}\",\n        \"checkout\": \"{{checkoutDate}}\"\n    },\n    \"additionalneeds\": \"Breakfast\"\n}"
